# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Default Vision Model (gemini-flash-latest, gemini-3.7-flash, etc.)
GEMINI_MODEL=gemini-flash-latest

# Global Hotkey (Default: <ctrl>+<space>)
GLOBAL_HOTKEY=<ctrl>+<space>

# Autonomous Mode: Auto-detect new clipboard screenshots without hotkey (true/false)
AUTO_DETECT_CLIPBOARD=false

# Auto Copy High-Level Caption to Clipboard (true/false)
AUTO_COPY_CLIPBOARD=true

# Audio Feedback Chime (true/false)
PLAY_AUDIO_FEEDBACK=true
