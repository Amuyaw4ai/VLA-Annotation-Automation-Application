# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Default Vision Model (gemini-2.0-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# Global Hotkey (Default: <alt>+<space>)
GLOBAL_HOTKEY=<alt>+<space>

# Auto Copy High-Level Caption to Clipboard (true/false)
AUTO_COPY_CLIPBOARD=true

# Audio Feedback Chime (true/false)
PLAY_AUDIO_FEEDBACK=true
